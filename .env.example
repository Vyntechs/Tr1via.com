# Copy to .env.local and fill in.

# Supabase (local dev: run `supabase start` and copy from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API — used for question generation
ANTHROPIC_API_KEY=

# Pexels — free, commercial-license stock photos (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Session cookie signing — generate with: openssl rand -base64 48
SESSION_SECRET=

# Public site URL — for QR codes & email magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── SIGN-IN CODE EMAILS (Zoho Mail SMTP, server only) ────────────────────
# /login emails hosts a 6-digit code (account without a password yet,
# "Forgot password?", new-account email check). Sent through Zoho Mail on the
# vyntechs.com domain over SSL, port 465. Real values live in .env.local +
# Vercel (Preview + Production), NEVER committed.
# ZOHO_SMTP_PASSWORD  Zoho app password for the mailbox below (required —
#                     without it no code is sent and hosts are told to text
#                     Brandon for a sign-in link)
# ZOHO_SMTP_USER      mailbox to send from (default support@vyntechs.com)
# ZOHO_SMTP_HOST      default smtp.zoho.com (the FREE Zoho organization plan,
#                     which vyntechs.com uses). A PAID Zoho Mail organization
#                     plan can use smtppro.zoho.com instead.
# Codes are hashed with SESSION_SECRET (above) — no extra secret needed.
ZOHO_SMTP_USER=support@vyntechs.com
ZOHO_SMTP_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.com

# ─── STRIPE (Trivia Nerd subscription — test mode) ───────────────────────
# Real values live in .env.local + Vercel, NEVER committed. Prefer a restricted
# key (rk_) over a secret key (sk_). The local webhook secret comes from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=

# ─── TEST RUNNER (set via the orchestration script, never in prod) ───────
# Enables /api/_test/* routes for the test orchestrator. Routes additionally
# require the x-test-secret header to match TEST_SECRET; both must hold.
# Setting only one or neither = routes 404 (deny existence).
TEST_AUTH_ENABLED=
TEST_SECRET=

# Base URLs for the Anthropic + Pexels mock servers used by tests.
# When MOCK_EXTERNAL=1, instrumentation.ts boots MSW handlers that intercept
# calls to api.anthropic.com / api.pexels.com.
MOCK_EXTERNAL=
ANTHROPIC_BASE_URL=
PEXELS_BASE_URL=

# ─── DIAGNOSTIC LOGGING (off by default) ──────────────────────────────────
# "on" records every answer tap, host press and device report into the diag_*
# tables (see docs/diagnostics/night-timeline.md). Unset or "off" = nothing
# is recorded and the code runs exactly as before. Set it for the PRODUCTION
# environment only. The server reads it on every request, but Vercel applies a
# changed value only to a NEW deployment, so never change it during a live show.
# DIAGNOSTIC_LOGGING=off
# Lets Vercel's daily cron call the 45-day cleanup (only does anything while
# DIAGNOSTIC_LOGGING is on). Any long random string.
# CRON_SECRET=
